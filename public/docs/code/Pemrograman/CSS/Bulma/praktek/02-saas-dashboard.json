{"schemaVersion":1,"type":"code-folder","folder":"02-saas-dashboard","path":"Pemrograman/CSS/Bulma/praktek/02-saas-dashboard","parentPath":"Pemrograman/CSS/Bulma/praktek","outputPath":"code/Pemrograman/CSS/Bulma/praktek/02-saas-dashboard","files":[{"name":"index.html","path":"Pemrograman/CSS/Bulma/praktek/02-saas-dashboard/index.html","extension":".html","language":"html","size":10395,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 02: SaaS Admin Panel (Bulma CSS)</title>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n</head>\n<body class=\"has-background-light\">\n  <!-- Top Navigation Header -->\n  <header class=\"navbar is-white has-shadow px-4\">\n    <div class=\"navbar-brand\">\n      <span class=\"navbar-item has-text-weight-bold has-text-primary is-size-5\">\n        <i class=\"fa-solid fa-gauge mr-2\"></i>BulmaAdmin\n      </span>\n    </div>\n    <div class=\"navbar-end\">\n      <div class=\"navbar-item\">\n        <button id=\"btnOpenModal\" class=\"button is-primary is-small is-rounded has-text-weight-semibold\">\n          <i class=\"fa-solid fa-plus mr-1\"></i> Entri Baru\n        </button>\n      </div>\n      <!-- User Profile Dropdown (CSS is-hoverable) -->\n      <div class=\"navbar-item\">\n        <div class=\"dropdown is-right is-hoverable\">\n          <div class=\"dropdown-trigger\">\n            <button class=\"button is-white\" aria-haspopup=\"true\">\n              <span class=\"icon\"><i class=\"fa-solid fa-circle-user fa-lg has-text-grey\"></i></span>\n              <span class=\"ml-1 has-text-weight-semibold is-size-7\">Aryanda</span>\n            </button>\n          </div>\n          <div class=\"dropdown-menu\" role=\"menu\">\n            <div class=\"dropdown-content\">\n              <a href=\"#\" class=\"dropdown-item\">Profil Saya</a>\n              <a href=\"#\" class=\"dropdown-item\">Setelan Akun</a>\n              <hr class=\"dropdown-divider\">\n              <a href=\"#\" class=\"dropdown-item has-text-danger\">Keluar</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"section py-5\">\n    <div class=\"container is-fluid max-w-1100\">\n      <!-- Breadcrumb Nav -->\n      <nav class=\"breadcrumb is-small mb-4\" aria-label=\"breadcrumbs\">\n        <ul>\n          <li><a href=\"#\" class=\"has-text-grey\">Home</a></li>\n          <li><a href=\"#\" class=\"has-text-grey\">Workspace</a></li>\n          <li class=\"is-active\"><a href=\"#\" aria-current=\"page\">Statistik & Pengguna</a></li>\n        </ul>\n      </nav>\n\n      <!-- Notification Banner -->\n      <div class=\"notification is-info is-light border-0 mb-5 py-3 px-4\">\n        <button class=\"delete\"></button>\n        <i class=\"fa-solid fa-circle-info mr-2\"></i>\n        <strong>Sistem Terkini:</strong> Integrasi webhook berhasil dikonfigurasi ke server produksi tanpa gangguan sinkronisasi.\n      </div>\n\n      <!-- KPI Summary Level / Columns -->\n      <div class=\"columns is-multiline mb-5\">\n        <div class=\"column is-3\">\n          <div class=\"box p-4 has-background-white shadow-sm border\">\n            <div class=\"level is-mobile mb-2\">\n              <div class=\"level-left\">\n                <span class=\"heading has-text-grey mb-0\">TOTAL PENDAPATAN</span>\n              </div>\n              <div class=\"level-right\">\n                <span class=\"icon has-text-success\"><i class=\"fa-solid fa-coins\"></i></span>\n              </div>\n            </div>\n            <div class=\"title is-4 has-text-dark mb-2\">Rp 94.2M</div>\n            <span class=\"tag is-success is-light is-rounded has-text-weight-bold\">\n              <i class=\"fa-solid fa-arrow-trend-up mr-1\"></i> +14.8%\n            </span>\n          </div>\n        </div>\n\n        <div class=\"column is-3\">\n          <div class=\"box p-4 has-background-white shadow-sm border\">\n            <div class=\"level is-mobile mb-2\">\n              <div class=\"level-left\">\n                <span class=\"heading has-text-grey mb-0\">PELANGGAN AKTIF</span>\n              </div>\n              <div class=\"level-right\">\n                <span class=\"icon has-text-info\"><i class=\"fa-solid fa-users\"></i></span>\n              </div>\n            </div>\n            <div class=\"title is-4 has-text-dark mb-2\">8,410</div>\n            <span class=\"tag is-info is-light is-rounded has-text-weight-bold\">\n              <i class=\"fa-solid fa-arrow-trend-up mr-1\"></i> +6.1%\n            </span>\n          </div>\n        </div>\n\n        <div class=\"column is-3\">\n          <div class=\"box p-4 has-background-white shadow-sm border\">\n            <div class=\"level is-mobile mb-2\">\n              <div class=\"level-left\">\n                <span class=\"heading has-text-grey mb-0\">TIKET DUKUNGAN</span>\n              </div>\n              <div class=\"level-right\">\n                <span class=\"icon has-text-warning\"><i class=\"fa-solid fa-headset\"></i></span>\n              </div>\n            </div>\n            <div class=\"title is-4 has-text-dark mb-2\">18</div>\n            <span class=\"tag is-warning is-light is-rounded has-text-weight-bold\">\n              3 Dalam Proses\n            </span>\n          </div>\n        </div>\n\n        <div class=\"column is-3\">\n          <div class=\"box p-4 has-background-white shadow-sm border\">\n            <div class=\"level is-mobile mb-2\">\n              <div class=\"level-left\">\n                <span class=\"heading has-text-grey mb-0\">KAPASITAS SERVER</span>\n              </div>\n              <div class=\"level-right\">\n                <span class=\"icon has-text-primary\"><i class=\"fa-solid fa-server\"></i></span>\n              </div>\n            </div>\n            <div class=\"title is-4 has-text-dark mb-2\">99.9%</div>\n            <span class=\"tag is-primary is-light is-rounded has-text-weight-bold\">\n              Sangat Stabil\n            </span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Data Table Card Box -->\n      <div class=\"box p-0 has-background-white shadow-sm border overflow-hidden\">\n        <div class=\"p-4 border-bottom is-flex is-justify-content-between is-align-items-center\">\n          <h3 class=\"title is-5 mb-0\">Daftar Akun Pengembang</h3>\n          <span class=\"tag is-light is-rounded\">4 Akun Terdaftar</span>\n        </div>\n        <div class=\"table-container mb-0\">\n          <table class=\"table is-fullwidth is-hoverable is-striped\">\n            <thead>\n              <tr class=\"has-background-light\">\n                <th class=\"pl-4\">Nama Lengkap</th>\n                <th>Peran Pekerjaan</th>\n                <th>Status Verifikasi</th>\n                <th>Bergabung</th>\n                <th class=\"has-text-right pr-4\">Aksi</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td class=\"pl-4 has-text-weight-semibold\">Aryanda Saputra</td>\n                <td>Lead Security Specialist</td>\n                <td><span class=\"tag is-success is-rounded\">Aktif</span></td>\n                <td class=\"has-text-grey is-size-7\">Hari ini, 10:14</td>\n                <td class=\"has-text-right pr-4\">\n                  <button class=\"button is-small is-light is-rounded\">Detail</button>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"pl-4 has-text-weight-semibold\">Bambang Susanto</td>\n                <td>DevOps Engineer</td>\n                <td><span class=\"tag is-success is-rounded\">Aktif</span></td>\n                <td class=\"has-text-grey is-size-7\">Kemarin, 16:30</td>\n                <td class=\"has-text-right pr-4\">\n                  <button class=\"button is-small is-light is-rounded\">Detail</button>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"pl-4 has-text-weight-semibold\">Clarissa Putri</td>\n                <td>UI/UX Designer</td>\n                <td><span class=\"tag is-warning is-rounded\">Menunggu</span></td>\n                <td class=\"has-text-grey is-size-7\">3 hari lalu</td>\n                <td class=\"has-text-right pr-4\">\n                  <button class=\"button is-small is-light is-rounded\">Detail</button>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"pl-4 has-text-weight-semibold\">Dian Nugraha</td>\n                <td>Backend Developer</td>\n                <td><span class=\"tag is-danger is-rounded\">Nonaktif</span></td>\n                <td class=\"has-text-grey is-size-7\">2 minggu lalu</td>\n                <td class=\"has-text-right pr-4\">\n                  <button class=\"button is-small is-light is-rounded\">Detail</button>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <!-- Bulma Modal Component -->\n  <div id=\"modalNewUser\" class=\"modal\">\n    <div class=\"modal-background\"></div>\n    <div class=\"modal-card\">\n      <header class=\"modal-card-head\">\n        <p class=\"modal-card-title is-size-5 has-text-weight-bold\">Tambah Akun Pengembang</p>\n        <button class=\"delete close-modal\" aria-label=\"close\"></button>\n      </header>\n      <section class=\"modal-card-body\">\n        <div class=\"field mb-3\">\n          <label class=\"label is-small\">Nama Lengkap</label>\n          <div class=\"control has-icons-left\">\n            <input class=\"input is-rounded\" type=\"text\" placeholder=\"Contoh: Andi Pratama\">\n            <span class=\"icon is-small is-left\"><i class=\"fa-solid fa-user\"></i></span>\n          </div>\n        </div>\n        <div class=\"field mb-3\">\n          <label class=\"label is-small\">Alamat Email</label>\n          <div class=\"control has-icons-left\">\n            <input class=\"input is-rounded\" type=\"email\" placeholder=\"andi@bulmasphere.com\">\n            <span class=\"icon is-small is-left\"><i class=\"fa-solid fa-envelope\"></i></span>\n          </div>\n        </div>\n      </section>\n      <footer class=\"modal-card-foot is-justify-content-flex-end\">\n        <button class=\"button is-light is-rounded close-modal\">Batal</button>\n        <button class=\"button is-primary is-rounded has-text-weight-semibold\">Simpan Akun</button>\n      </footer>\n    </div>\n  </div>\n\n  <!-- Vanilla JS untuk Modal & Alert -->\n  <script>\n    const modal = document.getElementById('modalNewUser');\n    document.getElementById('btnOpenModal').addEventListener('click', () => modal.classList.add('is-active'));\n    document.querySelectorAll('.close-modal, .modal-background').forEach(el => el.addEventListener('click', () => modal.classList.remove('is-active')));\n    document.querySelectorAll('.notification .delete').forEach(el => el.addEventListener('click', () => el.parentNode.remove()));\n  </script>\n</body>\n</html>\n","contentHash":"sha256:248425eeee6c35cf77e0b412517302a8919f3941917a7b2ddd31b8df9c9a5dfb"}]}