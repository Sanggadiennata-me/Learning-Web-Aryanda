{"schemaVersion":1,"type":"code-folder","folder":"01-company-landing-page","path":"Pemrograman/CSS/Bootstrap/praktek/01-company-landing-page","parentPath":"Pemrograman/CSS/Bootstrap/praktek","outputPath":"code/Pemrograman/CSS/Bootstrap/praktek/01-company-landing-page","files":[{"name":"index.html","path":"Pemrograman/CSS/Bootstrap/praktek/01-company-landing-page/index.html","extension":".html","language":"html","size":6905,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 01: Company Landing Page (Bootstrap 5)</title>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\">\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n</head>\n<body class=\"bg-light text-dark\">\n  <!-- Navbar Responsif -->\n  <nav class=\"navbar navbar-expand-lg navbar-dark bg-dark sticky-top py-3 shadow-sm\">\n    <div class=\"container\">\n      <a class=\"navbar-brand fw-bold text-primary\" href=\"#\">\n        <i class=\"bi bi-bootstrap-fill me-2\"></i>NexusCorp\n      </a>\n      <button class=\"navbar-toggler border-0\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navContent\">\n        <span class=\"navbar-toggler-icon\"></span>\n      </button>\n      <div class=\"collapse navbar-collapse\" id=\"navContent\">\n        <ul class=\"navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-3\">\n          <li class=\"nav-item\"><a class=\"nav-link active\" href=\"#\">Beranda</a></li>\n          <li class=\"nav-item\"><a class=\"nav-link\" href=\"#layanan\">Layanan</a></li>\n          <li class=\"nav-item\"><a class=\"nav-link\" href=\"#tentang\">Tentang</a></li>\n          <li class=\"nav-item\"><a class=\"nav-link\" href=\"#kontak\">Kontak</a></li>\n        </ul>\n        <div class=\"ms-lg-3 mt-3 mt-lg-0\">\n          <a href=\"#kontak\" class=\"btn btn-primary px-4 fw-semibold rounded-pill\">Konsultasi Gratis</a>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <!-- Hero Section -->\n  <header class=\"py-5 bg-white border-bottom\">\n    <div class=\"container py-lg-4\">\n      <div class=\"row align-items-center g-5\">\n        <div class=\"col-lg-6 text-center text-lg-start\">\n          <span class=\"badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold\">\n            Solusi Rekayasa Digital 2026\n          </span>\n          <h1 class=\"display-5 fw-bold text-dark lh-sm mb-3\">\n            Transformasi Bisnis Lebih Cepat dengan Arsitektur Cloud\n          </h1>\n          <p class=\"lead text-secondary mb-4\">\n            Kami membantu perusahaan merancang aplikasi berskala tinggi, infrastruktur aman, dan otomatisasi alur kerja modern berbasis komponen teruji.\n          </p>\n          <div class=\"d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start\">\n            <a href=\"#layanan\" class=\"btn btn-primary btn-lg px-4 fw-semibold rounded-3 shadow\">Mulai Sekarang</a>\n            <a href=\"#tentang\" class=\"btn btn-outline-secondary btn-lg px-4 fw-semibold rounded-3\">Pelajari Alur</a>\n          </div>\n        </div>\n        <div class=\"col-lg-6 text-center\">\n          <div class=\"p-3 bg-light rounded-4 shadow-sm border\">\n            <img src=\"https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=700&q=80\" \n                 alt=\"Tim Rekayasa Perangkat Lunak\" \n                 class=\"img-fluid rounded-3 shadow\">\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- Layanan / Feature Cards Grid 12 Kolom -->\n  <section id=\"layanan\" class=\"py-5 bg-light\">\n    <div class=\"container py-4\">\n      <div class=\"text-center max-w-700 mx-auto mb-5\">\n        <h2 class=\"fw-bold text-dark\">Layanan Unggulan Kami</h2>\n        <p class=\"text-secondary\">Dibangun menggunakan sistem 12 kolom grid Bootstrap yang responsif.</p>\n      </div>\n\n      <div class=\"row g-4\">\n        <!-- Kolom 1 -->\n        <div class=\"col-md-6 col-lg-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4 p-3 transition\">\n            <div class=\"card-body\">\n              <div class=\"d-inline-flex p-3 bg-primary-subtle text-primary rounded-3 fs-3 mb-3\">\n                <i class=\"bi bi-shield-check\"></i>\n              </div>\n              <h5 class=\"card-title fw-bold text-dark\">Audit Keamanan Siber</h5>\n              <p class=\"card-text text-secondary\">Pemeriksaan kerentanan sistem web dan simulasi pengujian penetrasi menyeluruh.</p>\n              <a href=\"#\" class=\"btn btn-link text-primary text-decoration-none p-0 fw-semibold\">Lihat Selengkapnya &rarr;</a>\n            </div>\n          </div>\n        </div>\n\n        <!-- Kolom 2 -->\n        <div class=\"col-md-6 col-lg-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4 p-3 transition\">\n            <div class=\"card-body\">\n              <div class=\"d-inline-flex p-3 bg-success-subtle text-success rounded-3 fs-3 mb-3\">\n                <i class=\"bi bi-cloud-arrow-up\"></i>\n              </div>\n              <h5 class=\"card-title fw-bold text-dark\">Migrasi & DevOps Cloud</h5>\n              <p class=\"card-text text-secondary\">Otomatisasi deployment dengan Docker container dan pipeline CI/CD tanpa downtime.</p>\n              <a href=\"#\" class=\"btn btn-link text-success text-decoration-none p-0 fw-semibold\">Lihat Selengkapnya &rarr;</a>\n            </div>\n          </div>\n        </div>\n\n        <!-- Kolom 3 -->\n        <div class=\"col-md-6 col-lg-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4 p-3 transition\">\n            <div class=\"card-body\">\n              <div class=\"d-inline-flex p-3 bg-warning-subtle text-warning-emphasis rounded-3 fs-3 mb-3\">\n                <i class=\"bi bi-code-slash\"></i>\n              </div>\n              <h5 class=\"card-title fw-bold text-dark\">Pengembangan Web Modern</h5>\n              <p class=\"card-text text-secondary\">Pembangunan aplikasi responsif berkecepatan tinggi dengan standar antarmuka baku.</p>\n              <a href=\"#\" class=\"btn btn-link text-warning-emphasis text-decoration-none p-0 fw-semibold\">Lihat Selengkapnya &rarr;</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Newsletter Banner -->\n  <section id=\"kontak\" class=\"py-5 bg-primary text-white\">\n    <div class=\"container text-center py-4\">\n      <h3 class=\"fw-bold mb-3\">Siap Mengembangkan Proyek Anda?</h3>\n      <p class=\"text-white-50 max-w-600 mx-auto mb-4\">Daftarkan email Anda untuk berdiskusi dengan tim arsitek solusi kami.</p>\n      <div class=\"row justify-content-center\">\n        <div class=\"col-md-6\">\n          <div class=\"input-group mb-3\">\n            <input type=\"email\" class=\"form-control form-control-lg border-0\" placeholder=\"nama@perusahaan.com\">\n            <button class=\"btn btn-dark btn-lg px-4 fw-semibold\" type=\"button\">Kirim Pesan</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"py-4 bg-dark text-secondary text-center text-sm border-top border-secondary-subtle\">\n    <div class=\"container\">\n      <p class=\"mb-0\">&copy; 2026 NexusCorp. Dibangun dengan Bootstrap 5.</p>\n    </div>\n  </footer>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n","contentHash":"sha256:acbe3120f8bcbe8053aad76c707c58b21841ca510b599dc0822504de64f2096c"}]}