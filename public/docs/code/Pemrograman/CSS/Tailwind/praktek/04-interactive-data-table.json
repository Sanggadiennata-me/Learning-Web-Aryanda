{"schemaVersion":1,"type":"code-folder","folder":"04-interactive-data-table","path":"Pemrograman/CSS/Tailwind/praktek/04-interactive-data-table","parentPath":"Pemrograman/CSS/Tailwind/praktek","outputPath":"code/Pemrograman/CSS/Tailwind/praktek/04-interactive-data-table","files":[{"name":"index.html","path":"Pemrograman/CSS/Tailwind/praktek/04-interactive-data-table/index.html","extension":".html","language":"html","size":7227,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 04: Interactive Admin Data Table</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 p-6 md:p-10 font-sans text-slate-800\">\n  <div class=\"max-w-5xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden\">\n    <!-- Table Header Bar -->\n    <div class=\"p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n      <div>\n        <h2 class=\"text-xl font-bold text-slate-900\">Daftar Pengguna Aktif</h2>\n        <p class=\"text-sm text-slate-500 mt-0.5\">Kelola data pelanggan, hak akses, dan status verifikasi sistem.</p>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <input type=\"text\" placeholder=\"Cari nama atau email...\" class=\"px-3.5 py-2 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 w-full sm:w-64\">\n        <button class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition\">\n          + Tambah\n        </button>\n      </div>\n    </div>\n\n    <!-- Responsive Table Container -->\n    <div class=\"overflow-x-auto\">\n      <table class=\"w-full text-left text-sm text-slate-600\">\n        <!-- Table Head with Arbitrary Child Selector -->\n        <thead class=\"bg-slate-50 text-xs uppercase tracking-wider text-slate-500 font-semibold border-b border-slate-200 [&>tr>th]:py-3.5 [&>tr>th]:px-6\">\n          <tr>\n            <th>Pengguna</th>\n            <th>Peran</th>\n            <th>Status</th>\n            <th>Tanggal Daftar</th>\n            <th class=\"text-right\">Aksi</th>\n          </tr>\n        </thead>\n        <!-- Table Body with Even Striped Rows -->\n        <tbody class=\"divide-y divide-slate-100 [&>tr]:transition-colors\">\n          <!-- Row 1 -->\n          <tr class=\"even:bg-slate-50/50 hover:bg-blue-50/40\">\n            <td class=\"py-4 px-6 flex items-center gap-3\">\n              <div class=\"w-9 h-9 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-xs\">AS</div>\n              <div>\n                <div class=\"font-semibold text-slate-900\">Aryanda S.</div>\n                <div class=\"text-xs text-slate-400\">aryanda@example.com</div>\n              </div>\n            </td>\n            <td class=\"py-4 px-6 font-medium text-slate-700\">Administrator</td>\n            <td class=\"py-4 px-6\">\n              <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span> Aktif\n              </span>\n            </td>\n            <td class=\"py-4 px-6 text-slate-500\">12 Feb 2026</td>\n            <td class=\"py-4 px-6 text-right\">\n              <button class=\"text-slate-400 hover:text-blue-600 font-semibold text-xs\">Edit</button>\n            </td>\n          </tr>\n\n          <!-- Row 2 -->\n          <tr class=\"even:bg-slate-50/50 hover:bg-blue-50/40\">\n            <td class=\"py-4 px-6 flex items-center gap-3\">\n              <div class=\"w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-xs\">BP</div>\n              <div>\n                <div class=\"font-semibold text-slate-900\">Budi Pratama</div>\n                <div class=\"text-xs text-slate-400\">budi@example.com</div>\n              </div>\n            </td>\n            <td class=\"py-4 px-6 font-medium text-slate-700\">Editor</td>\n            <td class=\"py-4 px-6\">\n              <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-amber-500\"></span> Pending\n              </span>\n            </td>\n            <td class=\"py-4 px-6 text-slate-500\">28 Jan 2026</td>\n            <td class=\"py-4 px-6 text-right\">\n              <button class=\"text-slate-400 hover:text-blue-600 font-semibold text-xs\">Edit</button>\n            </td>\n          </tr>\n\n          <!-- Row 3 -->\n          <tr class=\"even:bg-slate-50/50 hover:bg-blue-50/40\">\n            <td class=\"py-4 px-6 flex items-center gap-3\">\n              <div class=\"w-9 h-9 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs\">CD</div>\n              <div>\n                <div class=\"font-semibold text-slate-900\">Citra Dewi</div>\n                <div class=\"text-xs text-slate-400\">citra@example.com</div>\n              </div>\n            </td>\n            <td class=\"py-4 px-6 font-medium text-slate-700\">Pelanggan</td>\n            <td class=\"py-4 px-6\">\n              <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span> Aktif\n              </span>\n            </td>\n            <td class=\"py-4 px-6 text-slate-500\">04 Jan 2026</td>\n            <td class=\"py-4 px-6 text-right\">\n              <button class=\"text-slate-400 hover:text-blue-600 font-semibold text-xs\">Edit</button>\n            </td>\n          </tr>\n\n          <!-- Row 4 -->\n          <tr class=\"even:bg-slate-50/50 hover:bg-blue-50/40\">\n            <td class=\"py-4 px-6 flex items-center gap-3\">\n              <div class=\"w-9 h-9 rounded-full bg-rose-100 text-rose-700 font-bold flex items-center justify-center text-xs\">DW</div>\n              <div>\n                <div class=\"font-semibold text-slate-900\">Dodi Wijaya</div>\n                <div class=\"text-xs text-slate-400\">dodi@example.com</div>\n              </div>\n            </td>\n            <td class=\"py-4 px-6 font-medium text-slate-700\">Pelanggan</td>\n            <td class=\"py-4 px-6\">\n              <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-slate-400\"></span> Nonaktif\n              </span>\n            </td>\n            <td class=\"py-4 px-6 text-slate-500\">19 Des 2025</td>\n            <td class=\"py-4 px-6 text-right\">\n              <button class=\"text-slate-400 hover:text-blue-600 font-semibold text-xs\">Edit</button>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- Table Footer / Pagination -->\n    <div class=\"p-4 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500\">\n      <span>Menampilkan 1 hingga 4 dari 42 data</span>\n      <div class=\"flex items-center gap-1\">\n        <button class=\"px-2.5 py-1.5 border rounded-lg hover:bg-slate-50 font-medium\">Sebelumnya</button>\n        <button class=\"px-2.5 py-1.5 border bg-blue-600 text-white rounded-lg font-medium\">1</button>\n        <button class=\"px-2.5 py-1.5 border rounded-lg hover:bg-slate-50 font-medium\">2</button>\n        <button class=\"px-2.5 py-1.5 border rounded-lg hover:bg-slate-50 font-medium\">Selanjutnya</button>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n","contentHash":"sha256:4699b1744a2068110026cea9e5d9b22129cadd0620733e4b15b8959ffedbf3ca"}]}