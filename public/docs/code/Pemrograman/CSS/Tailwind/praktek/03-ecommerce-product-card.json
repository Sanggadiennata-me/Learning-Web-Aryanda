{"schemaVersion":1,"type":"code-folder","folder":"03-ecommerce-product-card","path":"Pemrograman/CSS/Tailwind/praktek/03-ecommerce-product-card","parentPath":"Pemrograman/CSS/Tailwind/praktek","outputPath":"code/Pemrograman/CSS/Tailwind/praktek/03-ecommerce-product-card","files":[{"name":"index.html","path":"Pemrograman/CSS/Tailwind/praktek/03-ecommerce-product-card/index.html","extension":".html","language":"html","size":4232,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 03: Interactive E-Commerce Product Card</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-100 flex items-center justify-center min-h-screen p-6 font-sans\">\n  <div class=\"group relative w-full max-w-sm bg-white rounded-3xl p-4 border border-slate-200/80 shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1\">\n    <!-- Image Box with Badge -->\n    <div class=\"relative w-full h-64 bg-slate-100 rounded-2xl overflow-hidden mb-4\">\n      <img src=\"https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80\" \n           alt=\"Sepatu Sneaker Merah\" \n           class=\"w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500 ease-out\">\n      \n      <!-- Discount Badge dengan Animasi Pulse -->\n      <div class=\"absolute top-3 left-3 bg-rose-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg shadow-rose-600/30 flex items-center gap-1.5\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-white animate-pulse\"></span>\n        <span>DISKON 35%</span>\n      </div>\n\n      <!-- Wishlist Button -->\n      <button class=\"absolute top-3 right-3 w-9 h-9 bg-white/90 backdrop-blur-md rounded-full flex items-center justify-center text-slate-400 hover:text-rose-500 hover:scale-110 transition shadow-sm\">\n        ❤\n      </button>\n    </div>\n\n    <!-- Product Info -->\n    <div class=\"px-2\">\n      <div class=\"flex items-center justify-between text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1\">\n        <span>Sepatu Lari Pria</span>\n        <span class=\"text-amber-500 flex items-center gap-1\">★ 4.9 <span class=\"text-slate-400\">(128)</span></span>\n      </div>\n\n      <h2 class=\"text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors\">\n        Air Pegasus Speed Runner\n      </h2>\n      <p class=\"text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed\">\n        Bantalan responsif ultra-ringan dengan sirkulasi udara optimal untuk performa lari jarak jauh.\n      </p>\n\n      <!-- Color Selector using CSS :has() Variant -->\n      <div class=\"mt-4 pt-3 border-t border-slate-100\">\n        <span class=\"text-xs font-semibold text-slate-700 block mb-2\">Pilihan Warna:</span>\n        <div class=\"flex items-center gap-2.5\">\n          <!-- Opsi 1 (Merah - Checked) -->\n          <label class=\"cursor-pointer relative flex items-center justify-center p-0.5 rounded-full ring-offset-2 has-[:checked]:ring-2 has-[:checked]:ring-rose-500\">\n            <input type=\"radio\" name=\"color\" value=\"red\" checked class=\"sr-only\">\n            <span class=\"w-6 h-6 rounded-full bg-rose-600 block shadow-inner\"></span>\n          </label>\n          <!-- Opsi 2 (Biru) -->\n          <label class=\"cursor-pointer relative flex items-center justify-center p-0.5 rounded-full ring-offset-2 has-[:checked]:ring-2 has-[:checked]:ring-blue-600\">\n            <input type=\"radio\" name=\"color\" value=\"blue\" class=\"sr-only\">\n            <span class=\"w-6 h-6 rounded-full bg-blue-600 block shadow-inner\"></span>\n          </label>\n          <!-- Opsi 3 (Hitam) -->\n          <label class=\"cursor-pointer relative flex items-center justify-center p-0.5 rounded-full ring-offset-2 has-[:checked]:ring-2 has-[:checked]:ring-slate-900\">\n            <input type=\"radio\" name=\"color\" value=\"black\" class=\"sr-only\">\n            <span class=\"w-6 h-6 rounded-full bg-slate-900 block shadow-inner\"></span>\n          </label>\n        </div>\n      </div>\n\n      <!-- Price & CTA -->\n      <div class=\"flex items-center justify-between mt-5 pt-3 border-t border-slate-100\">\n        <div>\n          <span class=\"text-xs text-slate-400 line-through block\">Rp 1.899.000</span>\n          <span class=\"text-xl font-extrabold text-slate-900\">Rp 1.234.000</span>\n        </div>\n        <button class=\"bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-blue-600/25 transition-all\">\n          + Keranjang\n        </button>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n","contentHash":"sha256:51f224a1ab62e705adc9a1df10ce6b2fd940d43a7ba83f5a0eaf5bfb3be839b2"}]}