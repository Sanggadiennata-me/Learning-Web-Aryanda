{"schemaVersion":1,"type":"code-folder","folder":"01-ecommerce-product-catalog","path":"Pemrograman/CSS/Semantic UI/praktek/01-ecommerce-product-catalog","parentPath":"Pemrograman/CSS/Semantic UI/praktek","outputPath":"code/Pemrograman/CSS/Semantic UI/praktek/01-ecommerce-product-catalog","files":[{"name":"index.html","path":"Pemrograman/CSS/Semantic UI/praktek/01-ecommerce-product-catalog/index.html","extension":".html","language":"html","size":10333,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Katalog Produk Semantic UI</title>\n  \n  <!-- Fomantic-UI (Semantic UI Modern Edition) CSS -->\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.css\">\n  \n  <style>\n    body {\n      background-color: #f7f9fa;\n      padding-bottom: 60px;\n    }\n    .main-container {\n      margin-top: 30px;\n    }\n    .product-img {\n      height: 200px;\n      object-fit: cover;\n      width: 100%;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- 1. Navigasi Atas Menu -->\n  <div class=\"ui inverted blue borderless menu\">\n    <div class=\"ui container\">\n      <a href=\"#\" class=\"header item\">\n        <i class=\"shopping bag icon\"></i>\n        TechStore ID\n      </a>\n      <a href=\"#\" class=\"active item\">Semua Produk</a>\n      <a href=\"#\" class=\"item\">Promo Kilat</a>\n      <a href=\"#\" class=\"item\">Garansi Resmi</a>\n\n      <div class=\"right menu\">\n        <div class=\"item\">\n          <div class=\"ui transparent inverted icon input\">\n            <input type=\"text\" placeholder=\"Cari gadget idaman...\">\n            <i class=\"search link icon\"></i>\n          </div>\n        </div>\n        <div class=\"item\">\n          <button class=\"ui teal button\">\n            <i class=\"cart icon\"></i>\n            Keranjang\n            <div class=\"ui floating circular label red\">3</div>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 2. Konten Utama: Sistem Grid 16 Kolom -->\n  <div class=\"ui container main-container\">\n    <div class=\"ui stackable grid\">\n\n      <!-- Kolom Kiri: Filter Menu (4 Wide dari 16 Kolom) -->\n      <div class=\"four wide column\">\n        <div class=\"ui vertical menu fluid\">\n          <div class=\"header item\">\n            <i class=\"filter icon\"></i>\n            Kategori Perangkat\n          </div>\n          <a class=\"active teal item\">\n            Laptop & Komputer\n            <div class=\"ui teal left pointing label\">14</div>\n          </a>\n          <a class=\"item\">\n            Smartphone & Tablet\n            <div class=\"ui label\">8</div>\n          </a>\n          <a class=\"item\">\n            Aksesoris & Audio\n            <div class=\"ui label\">25</div>\n          </a>\n          <a class=\"item\">\n            Smartwatch\n            <div class=\"ui label\">6</div>\n          </a>\n        </div>\n\n        <div class=\"ui segment\">\n          <h4 class=\"ui header\">Rentang Harga</h4>\n          <div class=\"ui form\">\n            <div class=\"field\">\n              <div class=\"ui radio checkbox\">\n                <input type=\"radio\" name=\"harga\" checked>\n                <label>Semua Harga</label>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"ui radio checkbox\">\n                <input type=\"radio\" name=\"harga\">\n                <label>Di bawah Rp 5 Juta</label>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"ui radio checkbox\">\n                <input type=\"radio\" name=\"harga\">\n                <label>Rp 5 Juta - Rp 15 Juta</label>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"ui radio checkbox\">\n                <input type=\"radio\" name=\"harga\">\n                <label>Di atas Rp 15 Juta</label>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Kolom Kanan: Katalog Produk (12 Wide dari 16 Kolom) -->\n      <div class=\"twelve wide column\">\n        <div class=\"ui clearing segment\">\n          <h3 class=\"ui left floated header\">\n            Daftar Produk Unggulan\n            <div class=\"sub header\">Menampilkan 3 dari 45 koleksi gadget terkini</div>\n          </h3>\n          <div class=\"ui right floated dropdown button\">\n            <span class=\"text\">Urutkan: Rekomendasi</span>\n            <i class=\"dropdown icon\"></i>\n            <div class=\"menu\">\n              <div class=\"item\">Rekomendasi</div>\n              <div class=\"item\">Harga Terendah</div>\n              <div class=\"item\">Harga Tertinggi</div>\n              <div class=\"item\">Ulasan Terbanyak</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Tiga Kartu Produk Berjejer -->\n        <div class=\"ui three stackable cards\">\n\n          <!-- Kartu 1 -->\n          <div class=\"ui card\">\n            <div class=\"image\">\n              <div class=\"ui red ribbon label\">Diskon 15%</div>\n              <img class=\"product-img\" src=\"https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=500&auto=format&fit=crop\" alt=\"MacBook Pro\">\n            </div>\n            <div class=\"content\">\n              <div class=\"header\">MacBook Pro M3</div>\n              <div class=\"meta\">\n                <span class=\"category\">Laptop & Komputer</span>\n              </div>\n              <div class=\"description\">\n                Performa luar biasa dengan prosesor arsitektur 3nm generasi terbaru untuk kebutuhan komputasi berat.\n              </div>\n            </div>\n            <div class=\"extra content\">\n              <div class=\"ui right floated primary header\" style=\"margin-bottom: 0; font-size: 1.15rem;\">\n                Rp 24.999.000\n              </div>\n              <div class=\"ui star rating\" data-rating=\"5\" data-max-rating=\"5\"></div>\n            </div>\n            <div class=\"ui bottom attached button primary btn-detail\" data-nama=\"MacBook Pro M3\" data-harga=\"Rp 24.999.000\">\n              <i class=\"eye icon\"></i>\n              Lihat Detail\n            </div>\n          </div>\n\n          <!-- Kartu 2 -->\n          <div class=\"ui card\">\n            <div class=\"image\">\n              <div class=\"ui green ribbon label\">Terlaris</div>\n              <img class=\"product-img\" src=\"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&auto=format&fit=crop\" alt=\"Headphone Wireless\">\n            </div>\n            <div class=\"content\">\n              <div class=\"header\">AudioPro Wireless ANC</div>\n              <div class=\"meta\">\n                <span class=\"category\">Aksesoris & Audio</span>\n              </div>\n              <div class=\"description\">\n                Peredam kebisingan aktif tingkat studio dengan daya tahan baterai hingga 40 jam penggunaan nonstop.\n              </div>\n            </div>\n            <div class=\"extra content\">\n              <div class=\"ui right floated primary header\" style=\"margin-bottom: 0; font-size: 1.15rem;\">\n                Rp 2.450.000\n              </div>\n              <div class=\"ui star rating\" data-rating=\"4\" data-max-rating=\"5\"></div>\n            </div>\n            <div class=\"ui bottom attached button primary btn-detail\" data-nama=\"AudioPro Wireless ANC\" data-harga=\"Rp 2.450.000\">\n              <i class=\"eye icon\"></i>\n              Lihat Detail\n            </div>\n          </div>\n\n          <!-- Kartu 3 -->\n          <div class=\"ui card\">\n            <div class=\"image\">\n              <div class=\"ui blue ribbon label\">Baru Masuk</div>\n              <img class=\"product-img\" src=\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop\" alt=\"Jam Tangan Cerdas\">\n            </div>\n            <div class=\"content\">\n              <div class=\"header\">Pulse Watch Series 8</div>\n              <div class=\"meta\">\n                <span class=\"category\">Smartwatch</span>\n              </div>\n              <div class=\"description\">\n                Pelacak kesehatan jantung presisi, GPS mandiri, layar AMOLED cerah, dan ketahanan air hingga 50 meter.\n              </div>\n            </div>\n            <div class=\"extra content\">\n              <div class=\"ui right floated primary header\" style=\"margin-bottom: 0; font-size: 1.15rem;\">\n                Rp 4.199.000\n              </div>\n              <div class=\"ui star rating\" data-rating=\"4\" data-max-rating=\"5\"></div>\n            </div>\n            <div class=\"ui bottom attached button primary btn-detail\" data-nama=\"Pulse Watch Series 8\" data-harga=\"Rp 4.199.000\">\n              <i class=\"eye icon\"></i>\n              Lihat Detail\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- 3. Modal Dialog Pratinjau Produk -->\n  <div class=\"ui tiny modal\" id=\"modalDetailProduk\">\n    <i class=\"close icon\"></i>\n    <div class=\"header\" id=\"modalJudul\">\n      Detail Spesifikasi Produk\n    </div>\n    <div class=\"content\">\n      <div class=\"ui items\">\n        <div class=\"item\">\n          <div class=\"content\">\n            <div class=\"header\" id=\"modalNamaProduk\">Nama Produk</div>\n            <div class=\"meta\">\n              <span class=\"price\" id=\"modalHargaProduk\" style=\"font-weight: bold; color: #2185d0;\">Harga</span>\n            </div>\n            <div class=\"description\">\n              <p>Produk asli bergaransi distributor resmi selama 24 bulan. Layanan purna jual mencakup penggantian unit baru selama 14 hari pertama jika ditemukan cacat pabrik.</p>\n            </div>\n            <div class=\"extra\">\n              <div class=\"ui green label\"><i class=\"check icon\"></i> Stok Tersedia</div>\n              <div class=\"ui label\"><i class=\"shipping fast icon\"></i> Siap Kirim Hari Ini</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"actions\">\n      <div class=\"ui black cancel button\">Tutup</div>\n      <div class=\"ui positive right labeled icon button\">\n        Beli Sekarang\n        <i class=\"checkmark icon\"></i>\n      </div>\n    </div>\n  </div>\n\n  <!-- jQuery & Fomantic-UI JS -->\n  <script src=\"https://code.jquery.com/jquery-3.7.1.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.js\"></script>\n  <script>\n    $(document).ready(function() {\n      // Inisialisasi Rating Star\n      $('.ui.rating').rating({\n        interactive: false\n      });\n\n      // Inisialisasi Dropdown\n      $('.ui.dropdown').dropdown();\n\n      // Inisialisasi Radio Checkbox\n      $('.ui.checkbox').checkbox();\n\n      // Handler Modal Dialog\n      $('.btn-detail').on('click', function() {\n        const nama = $(this).data('nama');\n        const harga = $(this).data('harga');\n\n        $('#modalNamaProduk').text(nama);\n        $('#modalHargaProduk').text(harga);\n        $('#modalDetailProduk').modal('show');\n      });\n    });\n  </script>\n</body>\n</html>\n","contentHash":"sha256:22936fc7f2a04833627f09e53a8483685e46c075c39e628809ec2d4844e7118e"}]}