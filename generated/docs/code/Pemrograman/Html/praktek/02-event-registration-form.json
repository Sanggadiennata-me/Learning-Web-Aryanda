{"schemaVersion":1,"type":"code-folder","folder":"02-event-registration-form","path":"Pemrograman/Html/praktek/02-event-registration-form","parentPath":"Pemrograman/Html/praktek","outputPath":"code/Pemrograman/Html/praktek/02-event-registration-form","files":[{"name":"index.html","path":"Pemrograman/Html/praktek/02-event-registration-form/index.html","extension":".html","language":"html","size":9549,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Formulir Registrasi Konferensi Teknologi Nusantara 2026</title>\n\n  <style>\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      line-height: 1.6;\n      background-color: #f1f5f9;\n      color: #0f172a;\n      padding: 20px;\n      margin: 0;\n    }\n    .form-card {\n      max-width: 750px;\n      margin: 0 auto;\n      background: #ffffff;\n      padding: 30px;\n      border-radius: 8px;\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n    }\n    h1 {\n      color: #1e3a8a;\n      border-bottom: 2px solid #e2e8f0;\n      padding-bottom: 12px;\n      margin-top: 0;\n    }\n    fieldset {\n      border: 1px solid #cbd5e1;\n      border-radius: 6px;\n      padding: 16px;\n      margin-bottom: 20px;\n    }\n    legend {\n      font-weight: bold;\n      color: #1e40af;\n      padding: 0 8px;\n    }\n    .field {\n      margin-bottom: 15px;\n    }\n    label {\n      display: block;\n      margin-bottom: 5px;\n      font-weight: 500;\n    }\n    input[type=\"text\"],\n    input[type=\"email\"],\n    input[type=\"tel\"],\n    input[type=\"date\"],\n    input[type=\"number\"],\n    input[type=\"url\"],\n    select,\n    textarea {\n      width: 100%;\n      padding: 8px 10px;\n      border: 1px solid #94a3b8;\n      border-radius: 4px;\n      box-sizing: border-box;\n      font-size: 14px;\n    }\n    input:focus, select:focus, textarea:focus {\n      outline: none;\n      border-color: #2563eb;\n      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);\n    }\n    .hint {\n      font-size: 12px;\n      color: #64748b;\n      margin-top: 4px;\n    }\n    .radio-group, .checkbox-group {\n      display: flex;\n      gap: 20px;\n      margin-top: 6px;\n    }\n    .radio-group label, .checkbox-group label {\n      font-weight: normal;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      cursor: pointer;\n    }\n    button[type=\"submit\"] {\n      background-color: #16a34a;\n      color: #ffffff;\n      font-size: 16px;\n      font-weight: bold;\n      padding: 12px 24px;\n      border: none;\n      border-radius: 6px;\n      cursor: pointer;\n      width: 100%;\n    }\n    button[type=\"submit\"]:hover {\n      background-color: #15803d;\n    }\n    details {\n      background: #f8fafc;\n      border: 1px solid #e2e8f0;\n      border-radius: 6px;\n      padding: 12px;\n      margin-top: 25px;\n    }\n    summary {\n      font-weight: bold;\n      cursor: pointer;\n      color: #1e3a8a;\n    }\n    dialog {\n      border: none;\n      border-radius: 8px;\n      padding: 24px;\n      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);\n      max-width: 450px;\n      text-align: center;\n    }\n    dialog::backdrop {\n      background: rgba(15, 23, 42, 0.6);\n    }\n    .btn-close {\n      background: #dc2626;\n      color: white;\n      border: none;\n      padding: 8px 16px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-weight: bold;\n      margin-top: 15px;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"form-card\">\n    <header>\n      <h1>Pendaftaran Nusantara DevCon 2026</h1>\n      <p>Konferensi Pengembang Web dan Arsitektur Cloud Terbesar di Indonesia. Silakan lengkapi formulir pendaftaran di bawah ini.</p>\n    </header>\n\n    <!-- Formulir Pendaftaran Lengkap -->\n    <form id=\"formRegistrasi\">\n      \n      <!-- Bagian 1: Data Pribadi Peserta -->\n      <fieldset>\n        <legend>1. Data Pribadi Peserta</legend>\n\n        <div class=\"field\">\n          <label for=\"namaLengkap\">Nama Lengkap Sesuai KTP <span style=\"color: red;\">*</span></label>\n          <input type=\"text\" id=\"namaLengkap\" name=\"nama\" placeholder=\"Masukkan nama resmi Anda\" required minlength=\"3\" maxlength=\"60\">\n        </div>\n\n        <div class=\"field\">\n          <label for=\"emailPeserta\">Alamat Surel (Email) <span style=\"color: red;\">*</span></label>\n          <input type=\"email\" id=\"emailPeserta\" name=\"email\" placeholder=\"nama@domain.com\" required>\n          <div class=\"hint\">E-Tiket resmi dan barcode masuk akan dikirimkan ke email ini.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"noTelepon\">Nomor WhatsApp / HP <span style=\"color: red;\">*</span></label>\n          <input type=\"tel\" id=\"noTelepon\" name=\"telepon\" placeholder=\"Contoh: 081234567890\" pattern=\"[0-9]{10,14}\" required>\n          <div class=\"hint\">Format 10 sampai 14 digit angka tanpa spasi atau tanda hubung.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"asalKota\">Kota Domisili (Didukung Fitur Datalist)</label>\n          <input list=\"daftarKota\" id=\"asalKota\" name=\"kota\" placeholder=\"Ketik atau pilih kota Anda\">\n          <!-- Elemen Datalist untuk Autocomplete Native -->\n          <datalist id=\"daftarKota\">\n            <option value=\"Jakarta\">\n            <option value=\"Bandung\">\n            <option value=\"Surabaya\">\n            <option value=\"Yogyakarta\">\n            <option value=\"Semarang\">\n            <option value=\"Medan\">\n            <option value=\"Makassar\">\n            <option value=\"Denpasar\">\n          </datalist>\n        </div>\n      </fieldset>\n\n      <!-- Bagian 2: Preferensi Tiket & Sesi -->\n      <fieldset>\n        <legend>2. Kategori Tiket dan Sesi Konferensi</legend>\n\n        <div class=\"field\">\n          <label>Pilih Jenis Tiket Masuk <span style=\"color: red;\">*</span></label>\n          <div class=\"radio-group\">\n            <label>\n              <input type=\"radio\" name=\"jenisTiket\" value=\"reguler\" checked required>\n              Reguler (Akses 1 Hari)\n            </label>\n            <label>\n              <input type=\"radio\" name=\"jenisTiket\" value=\"vip\">\n              VIP (Akses 2 Hari + Kursi Terdepan)\n            </label>\n            <label>\n              <input type=\"radio\" name=\"jenisTiket\" value=\"student\">\n              Pelajar / Mahasiswa\n            </label>\n          </div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"jumlahTiket\">Jumlah Tiket yang Dipesan</label>\n          <input type=\"number\" id=\"jumlahTiket\" name=\"jumlah\" min=\"1\" max=\"5\" value=\"1\">\n          <div class=\"hint\">Maksimal 5 tiket per transaksi pendaftaran.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"trackFokus\">Track Pembahasan Utama</label>\n          <select id=\"trackFokus\" name=\"track\">\n            <optgroup label=\"Frontend Engineering\">\n              <option value=\"html-css\">HTML5 Semantic & Modern CSS Architecture</option>\n              <option value=\"react-next\">React & Next.js Performance</option>\n            </optgroup>\n            <optgroup label=\"Backend & Cloud\">\n              <option value=\"node-api\">Node.js High Performance APIs</option>\n              <option value=\"devops\">Docker & Kubernetes Orchestration</option>\n            </optgroup>\n          </select>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"portofolioUrl\">Tautan LinkedIn atau Portofolio (Opsional)</label>\n          <input type=\"url\" id=\"portofolioUrl\" name=\"portofolio\" placeholder=\"https://linkedin.com/in/profil-anda\">\n        </div>\n      </fieldset>\n\n      <!-- Bagian 3: Unggah Berkas & Persetujuan -->\n      <fieldset>\n        <legend>3. Dokumen & Persetujuan</legend>\n\n        <div class=\"field\">\n          <label for=\"fotoIdentitas\">Unggah Foto Kartu Identitas (KTP / Kartu Pelajar)</label>\n          <input type=\"file\" id=\"fotoIdentitas\" name=\"identitas\" accept=\"image/png, image/jpeg, application/pdf\">\n        </div>\n\n        <div class=\"field\">\n          <div class=\"checkbox-group\">\n            <label>\n              <input type=\"checkbox\" name=\"syarat\" required>\n              Saya menyatakan data yang diisi adalah valid dan bersedia mematuhi tata tertib konferensi.\n            </label>\n          </div>\n        </div>\n      </fieldset>\n\n      <!-- Tombol Submit Formulir -->\n      <button type=\"submit\">Konfirmasi dan Daftarkan Diri Sekarang</button>\n    </form>\n\n    <!-- Elemen Interaktif Native: Details & Summary -->\n    <details>\n      <summary>Pertanyaan Umum Seputar Konferensi (FAQ)</summary>\n      <p style=\"margin-top: 10px;\">\n        <strong>Apakah peserta mendapatkan sertifikat?</strong><br>\n        Ya, seluruh peserta yang hadir akan mendapatkan e-certificate resmi bertaraf internasional.\n      </p>\n      <p>\n        <strong>Apakah tiket dapat dipindahtangankan?</strong><br>\n        Tiket dapat diubah nama kepemilikannya paling lambat 3 hari sebelum acara dimulai melalui panel bantuan.\n      </p>\n    </details>\n\n    <!-- Elemen Modal Dialog Native HTML5 -->\n    <dialog id=\"modalKonfirmasi\">\n      <h2 style=\"color: #16a34a; margin-top: 0;\">Pendaftaran Berhasil Dikirim!</h2>\n      <p id=\"pesanSukses\">\n        Terima kasih telah mendaftar di Nusantara DevCon 2026. Berkas bukti registrasi dan instruksi pembayaran telah dikirimkan ke alamat email Anda.\n      </p>\n      <button type=\"button\" class=\"btn-close\" id=\"btnTutupDialog\">Tutup Notifikasi</button>\n    </dialog>\n  </div>\n\n  <!-- Skrip Minimal Pengendali Dialog Modal Native -->\n  <script>\n    const form = document.getElementById('formRegistrasi');\n    const dialog = document.getElementById('modalKonfirmasi');\n    const btnTutup = document.getElementById('btnTutupDialog');\n\n    form.addEventListener('submit', function(event) {\n      event.preventDefault(); // Mencegah reload halaman\n      dialog.showModal();     // Membuka modal native HTML5\n    });\n\n    btnTutup.addEventListener('click', function() {\n      dialog.close();         // Menutup modal native HTML5\n      form.reset();\n    });\n  </script>\n\n</body>\n</html>\n","contentHash":"sha256:be0944f000730686d80e3ef57243da64bd4ef22dab43f792eb2f13b092a288fa"}]}