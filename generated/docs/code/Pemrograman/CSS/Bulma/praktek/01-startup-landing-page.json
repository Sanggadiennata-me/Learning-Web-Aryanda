{"schemaVersion":1,"type":"code-folder","folder":"01-startup-landing-page","path":"Pemrograman/CSS/Bulma/praktek/01-startup-landing-page","parentPath":"Pemrograman/CSS/Bulma/praktek","outputPath":"code/Pemrograman/CSS/Bulma/praktek/01-startup-landing-page","files":[{"name":"index.html","path":"Pemrograman/CSS/Bulma/praktek/01-startup-landing-page/index.html","extension":".html","language":"html","size":8053,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 01: Startup Landing Page (Bulma CSS)</title>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n</head>\n<body class=\"has-background-light\">\n  <!-- Navbar Responsif Bulma -->\n  <nav class=\"navbar is-white has-shadow is-spaced\" role=\"navigation\" aria-label=\"main navigation\">\n    <div class=\"container\">\n      <div class=\"navbar-brand\">\n        <a class=\"navbar-item has-text-primary has-text-weight-bold is-size-4\" href=\"#\">\n          <i class=\"fa-solid fa-cube mr-2\"></i>BulmaSphere\n        </a>\n        <a role=\"button\" class=\"navbar-burger\" aria-label=\"menu\" aria-expanded=\"false\" data-target=\"navbarMain\">\n          <span aria-hidden=\"true\"></span>\n          <span aria-hidden=\"true\"></span>\n          <span aria-hidden=\"true\"></span>\n        </a>\n      </div>\n\n      <div id=\"navbarMain\" class=\"navbar-menu\">\n        <div class=\"navbar-start ml-4\">\n          <a class=\"navbar-item is-active\" href=\"#\">Beranda</a>\n          <a class=\"navbar-item\" href=\"#fitur\">Fitur Utama</a>\n          <a class=\"navbar-item\" href=\"#harga\">Harga</a>\n          <a class=\"navbar-item\" href=\"#kontak\">Kontak</a>\n        </div>\n\n        <div class=\"navbar-end\">\n          <div class=\"navbar-item\">\n            <div class=\"buttons\">\n              <a class=\"button is-light is-rounded\">Masuk</a>\n              <a class=\"button is-primary is-rounded has-text-weight-semibold\">Mulai Gratis</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <!-- Hero Section Panggung Utama -->\n  <section class=\"hero is-primary is-medium\">\n    <div class=\"hero-body\">\n      <div class=\"container has-text-centered\">\n        <span class=\"tag is-info is-light is-rounded is-medium mb-4 has-text-weight-semibold\">\n          🚀 Framework CSS Murni Tanpa Ketergantungan JS\n        </span>\n        <h1 class=\"title is-1 has-text-weight-extrabold mb-4\">\n          Bangun Web Modern dengan Sintaks Manusiawi\n        </h1>\n        <p class=\"subtitle is-4 max-w-700 mx-auto mb-6\">\n          Bulma mengandalkan arsitektur Flexbox murni. Seluruh nama class dirancang sangat mudah dibaca seperti membaca kalimat biasa dalam bahasa Inggris.\n        </p>\n        <div class=\"buttons is-centered\">\n          <a href=\"#fitur\" class=\"button is-white is-medium is-rounded has-text-primary has-text-weight-bold shadow\">\n            Jelajahi Fitur\n          </a>\n          <a href=\"#kontak\" class=\"button is-primary is-dark is-medium is-rounded\">\n            Dokumentasi API\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Fitur Utama dengan Kolom Flexbox Bulma -->\n  <section id=\"fitur\" class=\"section py-6\">\n    <div class=\"container\">\n      <div class=\"has-text-centered mb-6\">\n        <h2 class=\"title is-2 has-text-dark\">Kelebihan Menggunakan Bulma</h2>\n        <p class=\"subtitle is-5 has-text-grey\">Arsitektur ringan berbasis flexbox kolom yang proporsional.</p>\n      </div>\n\n      <div class=\"columns is-variable is-5\">\n        <!-- Kolom 1 -->\n        <div class=\"column is-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4\">\n            <div class=\"card-content p-5\">\n              <div class=\"media mb-4\">\n                <div class=\"media-left\">\n                  <span class=\"icon is-large has-text-primary\">\n                    <i class=\"fa-solid fa-code fa-2x\"></i>\n                  </span>\n                </div>\n                <div class=\"media-content\">\n                  <p class=\"title is-5 mb-1\">100% CSS Murni</p>\n                  <p class=\"subtitle is-6 has-text-grey\">Zero JavaScript Lock-in</p>\n                </div>\n              </div>\n              <div class=\"content has-text-grey-dark\">\n                Tidak memaksa Anda menggunakan library JS tertentu. Bebas dipadukan dengan React, Vue, Svelte, atau Vanilla JS murni.\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Kolom 2 -->\n        <div class=\"column is-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4\">\n            <div class=\"card-content p-5\">\n              <div class=\"media mb-4\">\n                <div class=\"media-left\">\n                  <span class=\"icon is-large has-text-info\">\n                    <i class=\"fa-solid fa-table-columns fa-2x\"></i>\n                  </span>\n                </div>\n                <div class=\"media-content\">\n                  <p class=\"title is-5 mb-1\">Sistem Kolom Flexbox</p>\n                  <p class=\"subtitle is-6 has-text-grey\">Responsif Alami</p>\n                </div>\n              </div>\n              <div class=\"content has-text-grey-dark\">\n                Cukup bungkus elemen dengan class <code>.columns</code> dan <code>.column</code>, seluruh anak elemen otomatis membagi ruang rata.\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Kolom 3 -->\n        <div class=\"column is-4\">\n          <div class=\"card h-100 border-0 shadow-sm rounded-4\">\n            <div class=\"card-content p-5\">\n              <div class=\"media mb-4\">\n                <div class=\"media-left\">\n                  <span class=\"icon is-large has-text-success\">\n                    <i class=\"fa-solid fa-wand-magic-sparkles fa-2x\"></i>\n                  </span>\n                </div>\n                <div class=\"media-content\">\n                  <p class=\"title is-5 mb-1\">Sintaks Sangat Jelas</p>\n                  <p class=\"subtitle is-6 has-text-grey\">Modifier is-* dan has-*</p>\n                </div>\n              </div>\n              <div class=\"content has-text-grey-dark\">\n                Nama class seperti <code>is-primary</code>, <code>is-loading</code>, dan <code>has-text-centered</code> sangat ramah bagi pemula.\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Newsletter Box -->\n  <section id=\"kontak\" class=\"section pt-0 pb-6\">\n    <div class=\"container\">\n      <div class=\"box p-6 has-background-white shadow-sm border rounded-4\">\n        <div class=\"columns is-vcentered\">\n          <div class=\"column is-7\">\n            <h3 class=\"title is-3 mb-2\">Tertarik Mencoba Modul Bulma?</h3>\n            <p class=\"subtitle is-6 has-text-grey\">Daftarkan email Anda untuk mendapatkan pembaruan panduan kode terbaru.</p>\n          </div>\n          <div class=\"column is-5\">\n            <div class=\"field has-addons\">\n              <div class=\"control is-expanded has-icons-left\">\n                <input class=\"input is-medium is-rounded\" type=\"email\" placeholder=\"nama@email.com\">\n                <span class=\"icon is-left\">\n                  <i class=\"fa-solid fa-envelope\"></i>\n                </span>\n              </div>\n              <div class=\"control\">\n                <button class=\"button is-primary is-medium is-rounded has-text-weight-bold\">\n                  Berlangganan\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer Sederhana -->\n  <footer class=\"footer has-background-white py-5 border-top\">\n    <div class=\"content has-text-centered has-text-grey is-size-7\">\n      <p>&copy; 2026 BulmaSphere. Dibangun dengan Bulma CSS v1.0.</p>\n    </div>\n  </footer>\n\n  <!-- Vanilla JS untuk Toggle Navbar Burger -->\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const $navbarBurgers = Array.prototype.slice.call(document.querySelectorAll('.navbar-burger'), 0);\n      $navbarBurgers.forEach(el => {\n        el.addEventListener('click', () => {\n          const target = el.dataset.target;\n          const $target = document.getElementById(target);\n          el.classList.toggle('is-active');\n          $target.classList.toggle('is-active');\n        });\n      });\n    });\n  </script>\n</body>\n</html>\n","contentHash":"sha256:07bab2c0df589abae22a1265775e6159e9dd6d3a361868dd57d100d74ea5c050"}]}