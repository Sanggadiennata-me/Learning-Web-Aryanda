{"schemaVersion":1,"type":"code-folder","folder":"02-admin-dashboard","path":"Pemrograman/CSS/Bootstrap/praktek/02-admin-dashboard","parentPath":"Pemrograman/CSS/Bootstrap/praktek","outputPath":"code/Pemrograman/CSS/Bootstrap/praktek/02-admin-dashboard","files":[{"name":"index.html","path":"Pemrograman/CSS/Bootstrap/praktek/02-admin-dashboard/index.html","extension":".html","language":"html","size":10242,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 02: Admin Dashboard (Bootstrap 5)</title>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\">\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n</head>\n<body class=\"bg-body-tertiary\">\n  <!-- Top Navigation Bar -->\n  <nav class=\"navbar navbar-expand-lg bg-white border-bottom sticky-top py-2 px-3 shadow-sm\">\n    <div class=\"container-fluid\">\n      <button class=\"btn btn-outline-secondary me-2 border-0\" type=\"button\" data-bs-toggle=\"offcanvas\" data-bs-target=\"#sidebarOffcanvas\">\n        <i class=\"bi bi-list fs-5\"></i>\n      </button>\n      <span class=\"navbar-brand fw-bold text-primary mb-0 h1\">NexusAdmin</span>\n      \n      <div class=\"ms-auto d-flex align-items-center gap-3\">\n        <button class=\"btn btn-primary btn-sm rounded-pill px-3\" data-bs-toggle=\"modal\" data-bs-target=\"#tambahModal\">\n          <i class=\"bi bi-plus-lg me-1\"></i> Data Baru\n        </button>\n        <div class=\"dropdown\">\n          <a href=\"#\" class=\"d-flex align-items-center text-dark text-decoration-none dropdown-toggle\" data-bs-toggle=\"dropdown\">\n            <div class=\"bg-primary text-white rounded-circle d-flex align-items-center justify-center fw-bold me-2\" style=\"width: 34px; height: 34px; line-height: 34px; text-align: center;\">A</div>\n            <span class=\"d-none d-md-inline fw-semibold text-sm\">Aryanda</span>\n          </a>\n          <ul class=\"dropdown-menu dropdown-menu-end shadow border-0 mt-2\">\n            <li><a class=\"dropdown-item\" href=\"#\"><i class=\"bi bi-person me-2\"></i>Profil</a></li>\n            <li><a class=\"dropdown-item\" href=\"#\"><i class=\"bi bi-gear me-2\"></i>Pengaturan</a></li>\n            <li><hr class=\"dropdown-divider\"></li>\n            <li><a class=\"dropdown-item text-danger\" href=\"#\"><i class=\"bi bi-box-arrow-right me-2\"></i>Keluar</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <!-- Offcanvas Sidebar Drawer -->\n  <div class=\"offcanvas offcanvas-start\" tabindex=\"-1\" id=\"sidebarOffcanvas\" style=\"width: 280px;\">\n    <div class=\"offcanvas-header border-bottom\">\n      <h5 class=\"offcanvas-title fw-bold text-primary\">Menu Navigasi</h5>\n      <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"offcanvas\"></button>\n    </div>\n    <div class=\"offcanvas-body p-0\">\n      <div class=\"list-group list-group-flush\">\n        <a href=\"#\" class=\"list-group-item list-group-item-action active py-3\">\n          <i class=\"bi bi-speedometer2 me-2\"></i> Dashboard Utama\n        </a>\n        <a href=\"#\" class=\"list-group-item list-group-item-action py-3\">\n          <i class=\"bi bi-people me-2\"></i> Manajemen Pengguna\n        </a>\n        <a href=\"#\" class=\"list-group-item list-group-item-action py-3\">\n          <i class=\"bi bi-shield-lock me-2\"></i> Log Keamanan\n        </a>\n        <a href=\"#\" class=\"list-group-item list-group-item-action py-3\">\n          <i class=\"bi bi-gear me-2\"></i> Konfigurasi Sistem\n        </a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Main Content Dashboard -->\n  <main class=\"container-fluid p-4\">\n    <!-- Alert Banner -->\n    <div class=\"alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4\" role=\"alert\">\n      <i class=\"bi bi-info-circle-fill me-2\"></i>\n      <strong>Pemberitahuan Sistem:</strong> Server database telah diperbarui ke versi stabil terbaru tanpa gangguan operasional.\n      <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\"></button>\n    </div>\n\n    <!-- KPI Summary Cards (Grid 12 Kolom) -->\n    <div class=\"row g-3 mb-4\">\n      <div class=\"col-sm-6 col-xl-3\">\n        <div class=\"card border-0 shadow-sm rounded-4 p-2\">\n          <div class=\"card-body\">\n            <span class=\"text-secondary small fw-semibold\">TOTAL PENDAPATAN</span>\n            <h3 class=\"fw-bold my-2 text-dark\">Rp 128.4M</h3>\n            <span class=\"badge bg-success-subtle text-success border border-success-subtle rounded-pill\">\n              <i class=\"bi bi-arrow-up-right\"></i> +12.5%\n            </span>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-sm-6 col-xl-3\">\n        <div class=\"card border-0 shadow-sm rounded-4 p-2\">\n          <div class=\"card-body\">\n            <span class=\"text-secondary small fw-semibold\">PENGGUNA AKTIF</span>\n            <h3 class=\"fw-bold my-2 text-dark\">14,290</h3>\n            <span class=\"badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill\">\n              <i class=\"bi bi-arrow-up-right\"></i> +8.2%\n            </span>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-sm-6 col-xl-3\">\n        <div class=\"card border-0 shadow-sm rounded-4 p-2\">\n          <div class=\"card-body\">\n            <span class=\"text-secondary small fw-semibold\">PERMINTAAN TIKET</span>\n            <h3 class=\"fw-bold my-2 text-dark\">48</h3>\n            <span class=\"badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill\">\n              2 Menunggu\n            </span>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-sm-6 col-xl-3\">\n        <div class=\"card border-0 shadow-sm rounded-4 p-2\">\n          <div class=\"card-body\">\n            <span class=\"text-secondary small fw-semibold\">UPTIME SERVER</span>\n            <h3 class=\"fw-bold my-2 text-dark\">99.98%</h3>\n            <span class=\"badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill\">\n              Stabil\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Data Table Card -->\n    <div class=\"card border-0 shadow-sm rounded-4 overflow-hidden\">\n      <div class=\"card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center\">\n        <h5 class=\"fw-bold mb-0 text-dark\">Daftar Akun Pengguna</h5>\n        <span class=\"badge bg-light text-dark border\">4 Entri Ditampilkan</span>\n      </div>\n      <div class=\"table-responsive\">\n        <table class=\"table table-hover align-middle mb-0\">\n          <thead class=\"table-light text-secondary small text-uppercase\">\n            <tr>\n              <th class=\"ps-4\">Nama Lengkap</th>\n              <th>Jabatan</th>\n              <th>Status</th>\n              <th>Terakhir Masuk</th>\n              <th class=\"text-end pe-4\">Aksi</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td class=\"ps-4 fw-semibold text-dark\">Aryanda Saputra</td>\n              <td>Lead Security Engineer</td>\n              <td><span class=\"badge bg-success rounded-pill\">Aktif</span></td>\n              <td class=\"text-secondary small\">Hari ini, 09:15</td>\n              <td class=\"text-end pe-4\">\n                <button class=\"btn btn-sm btn-outline-primary rounded-pill px-3\">Detail</button>\n              </td>\n            </tr>\n            <tr>\n              <td class=\"ps-4 fw-semibold text-dark\">Budi Santoso</td>\n              <td>DevOps Specialist</td>\n              <td><span class=\"badge bg-success rounded-pill\">Aktif</span></td>\n              <td class=\"text-secondary small\">Kemarin, 14:20</td>\n              <td class=\"text-end pe-4\">\n                <button class=\"btn btn-sm btn-outline-primary rounded-pill px-3\">Detail</button>\n              </td>\n            </tr>\n            <tr>\n              <td class=\"ps-4 fw-semibold text-dark\">Citra Kirana</td>\n              <td>Frontend Architect</td>\n              <td><span class=\"badge bg-warning text-dark rounded-pill\">Menunggu</span></td>\n              <td class=\"text-secondary small\">3 hari lalu</td>\n              <td class=\"text-end pe-4\">\n                <button class=\"btn btn-sm btn-outline-primary rounded-pill px-3\">Detail</button>\n              </td>\n            </tr>\n            <tr>\n              <td class=\"ps-4 fw-semibold text-dark\">Dodi Firmansyah</td>\n              <td>QA Tester</td>\n              <td><span class=\"badge bg-secondary rounded-pill\">Nonaktif</span></td>\n              <td class=\"text-secondary small\">1 minggu lalu</td>\n              <td class=\"text-end pe-4\">\n                <button class=\"btn btn-sm btn-outline-primary rounded-pill px-3\">Detail</button>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </main>\n\n  <!-- Modal Tambah Data Pop-up -->\n  <div class=\"modal fade\" id=\"tambahModal\" tabindex=\"-1\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n      <div class=\"modal-content border-0 shadow rounded-4\">\n        <div class=\"modal-header border-bottom\">\n          <h5 class=\"modal-title fw-bold\">Tambah Data Pengguna</h5>\n          <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\"></button>\n        </div>\n        <div class=\"modal-body p-4\">\n          <form>\n            <div class=\"mb-3\">\n              <label class=\"form-label small fw-semibold\">Nama Lengkap</label>\n              <input type=\"text\" class=\"form-control rounded-3\" placeholder=\"Contoh: Andi Pratama\">\n            </div>\n            <div class=\"mb-3\">\n              <label class=\"form-label small fw-semibold\">Alamat Email</label>\n              <input type=\"email\" class=\"form-control rounded-3\" placeholder=\"andi@nexus.com\">\n            </div>\n            <div class=\"mb-3\">\n              <label class=\"form-label small fw-semibold\">Hak Akses Peran</label>\n              <select class=\"form-select rounded-3\">\n                <option selected>Pilih peran...</option>\n                <option value=\"1\">Administrator</option>\n                <option value=\"2\">Editor</option>\n                <option value=\"3\">Viewer</option>\n              </select>\n            </div>\n          </form>\n        </div>\n        <div class=\"modal-footer border-top bg-light rounded-bottom-4\">\n          <button type=\"button\" class=\"btn btn-secondary rounded-3\" data-bs-dismiss=\"modal\">Batal</button>\n          <button type=\"button\" class=\"btn btn-primary rounded-3 px-4\">Simpan Akun</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n","contentHash":"sha256:a870efe2c623bd69e840bbc82e8ad50466c437e3fe56ca48e1ff7d6ee003a022"}]}