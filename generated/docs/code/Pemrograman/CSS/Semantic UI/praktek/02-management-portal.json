{"schemaVersion":1,"type":"code-folder","folder":"02-management-portal","path":"Pemrograman/CSS/Semantic UI/praktek/02-management-portal","parentPath":"Pemrograman/CSS/Semantic UI/praktek","outputPath":"code/Pemrograman/CSS/Semantic UI/praktek/02-management-portal","files":[{"name":"index.html","path":"Pemrograman/CSS/Semantic UI/praktek/02-management-portal/index.html","extension":".html","language":"html","size":11641,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Portal Manajemen Admin Semantic UI</title>\n  \n  <!-- Fomantic-UI CSS -->\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.css\">\n  \n  <style>\n    body {\n      background-color: #f4f6f9;\n    }\n    .pusher {\n      padding-top: 70px;\n      padding-bottom: 50px;\n      min-height: 100vh;\n    }\n  </style>\n</head>\n<body class=\"pushable\">\n\n  <!-- 1. Sidebar Navigasi Geser -->\n  <div class=\"ui sidebar inverted vertical menu left\">\n    <div class=\"item\">\n      <div class=\"header\">\n        <i class=\"shield alternate icon\"></i>\n        Admin Control\n      </div>\n    </div>\n    <a class=\"active item\"><i class=\"dashboard icon\"></i> Ringkasan Utama</a>\n    <a class=\"item\"><i class=\"users icon\"></i> Manajemen Pengguna</a>\n    <a class=\"item\"><i class=\"credit card icon\"></i> Transaksi & Billing</a>\n    <a class=\"item\"><i class=\"server icon\"></i> Status Infrastruktur</a>\n    <a class=\"item\"><i class=\"settings icon\"></i> Pengaturan Sistem</a>\n    <div class=\"item\">\n      <div class=\"ui orange label\">Versi 2.9</div>\n      Pembaruan\n    </div>\n  </div>\n\n  <!-- 2. Navigasi Atas Menu Tetap (Fixed Menu) -->\n  <div class=\"pusher\">\n    <div class=\"ui top fixed inverted blue menu\">\n      <a class=\"item\" id=\"btnToggleSidebar\">\n        <i class=\"sidebar icon\"></i>\n        Menu\n      </a>\n      <div class=\"header item\">\n        CloudManager OS\n      </div>\n      <div class=\"right menu\">\n        <div class=\"ui dropdown item\">\n          <i class=\"bell icon\"></i>\n          Notifikasi\n          <div class=\"ui red circular mini label\">2</div>\n          <div class=\"menu\">\n            <div class=\"header\">Pemberitahuan Sistem</div>\n            <div class=\"item\">Kapasitas penyimpanan server mencapai 85%</div>\n            <div class=\"item\">Sertifikat SSL baru berhasil diperbarui</div>\n          </div>\n        </div>\n        <div class=\"ui dropdown item\">\n          <i class=\"user circle icon\"></i>\n          Aryanda Pratama\n          <i class=\"dropdown icon\"></i>\n          <div class=\"menu\">\n            <a class=\"item\" href=\"#\"><i class=\"id badge icon\"></i> Profil Saya</a>\n            <a class=\"item\" href=\"#\"><i class=\"lock icon\"></i> Keamanan Sandi</a>\n            <div class=\"divider\"></div>\n            <a class=\"item\" href=\"#\" style=\"color: #db2828;\"><i class=\"sign out icon\"></i> Keluar</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 3. Konten Utama Portal -->\n    <div class=\"ui container\">\n\n      <!-- Header Halaman dan Breadcrumb -->\n      <div class=\"ui stackable grid\">\n        <div class=\"twelve wide column\">\n          <h2 class=\"ui header\">\n            <i class=\"chart line icon\"></i>\n            <div class=\"content\">\n              Panel Pengendalian Sistem\n              <div class=\"sub header\">Pantau performa layanan, beban pengguna, dan tiket bantuan secara real-time.</div>\n            </div>\n          </h2>\n        </div>\n        <div class=\"four wide column right aligned\">\n          <button class=\"ui green labeled icon button\" id=\"btnBukaModal\">\n            <i class=\"plus icon\"></i>\n            Tambah Operator\n          </button>\n        </div>\n      </div>\n\n      <div class=\"ui divider\"></div>\n\n      <!-- Empat Kartu Statistik -->\n      <div class=\"ui four statistics segment raised\">\n        <div class=\"statistic\">\n          <div class=\"value\">\n            <i class=\"users icon text blue\"></i> 14.820\n          </div>\n          <div class=\"label\">Total Pengguna Aktif</div>\n        </div>\n        <div class=\"statistic\">\n          <div class=\"value\">\n            Rp 428 Jt\n          </div>\n          <div class=\"label\">Omzet Bulan Ini</div>\n        </div>\n        <div class=\"statistic\">\n          <div class=\"value\">\n            <i class=\"ticket alternate icon text orange\"></i> 12\n          </div>\n          <div class=\"label\">Tiket Terbuka</div>\n        </div>\n        <div class=\"statistic\">\n          <div class=\"value\">\n            99.98%\n          </div>\n          <div class=\"label\">Tingkat Uptime Server</div>\n        </div>\n      </div>\n\n      <!-- Layout Grid Dua Kolom: Tabel Data dan Formulir Cepat -->\n      <div class=\"ui stackable grid\">\n\n        <!-- Kolom Kiri: Tabel Data (10 Wide dari 16) -->\n        <div class=\"ten wide column\">\n          <div class=\"ui segment\">\n            <h3 class=\"ui header\">\n              <i class=\"list icon\"></i>\n              Daftar Layanan Infrastruktur\n            </h3>\n\n            <table class=\"ui celled striped table selectable\">\n              <thead>\n                <tr>\n                  <th>Nama Node</th>\n                  <th>Wilayah (Region)</th>\n                  <th>Beban CPU</th>\n                  <th>Status</th>\n                  <th>Aksi</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <td><strong>node-sgp-01</strong></td>\n                  <td>Singapore (AP-SE)</td>\n                  <td>\n                    <div class=\"ui tiny progress green active\" data-percent=\"35\">\n                      <div class=\"bar\" style=\"width: 35%;\"></div>\n                    </div>\n                  </td>\n                  <td><span class=\"ui green label\">Normal</span></td>\n                  <td>\n                    <button class=\"ui mini basic blue button\">Pantau</button>\n                  </td>\n                </tr>\n                <tr>\n                  <td><strong>node-jkt-02</strong></td>\n                  <td>Jakarta (ID-JKT)</td>\n                  <td>\n                    <div class=\"ui tiny progress orange active\" data-percent=\"78\">\n                      <div class=\"bar\" style=\"width: 78%;\"></div>\n                    </div>\n                  </td>\n                  <td><span class=\"ui orange label\">Beban Tinggi</span></td>\n                  <td>\n                    <button class=\"ui mini basic blue button\">Pantau</button>\n                  </td>\n                </tr>\n                <tr>\n                  <td><strong>node-tok-01</strong></td>\n                  <td>Tokyo (AP-NE)</td>\n                  <td>\n                    <div class=\"ui tiny progress green active\" data-percent=\"22\">\n                      <div class=\"bar\" style=\"width: 22%;\"></div>\n                    </div>\n                  </td>\n                  <td><span class=\"ui green label\">Normal</span></td>\n                  <td>\n                    <button class=\"ui mini basic blue button\">Pantau</button>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        <!-- Kolom Kanan: Formulir Cepat dengan Validasi Bawaan (6 Wide dari 16) -->\n        <div class=\"six wide column\">\n          <div class=\"ui segment\">\n            <h3 class=\"ui header\">\n              <i class=\"envelope icon\"></i>\n              Kirim Pemberitahuan Darurat\n            </h3>\n\n            <form class=\"ui form\" id=\"formDarurat\">\n              <div class=\"field\">\n                <label>Judul Pemberitahuan</label>\n                <input type=\"text\" name=\"judul\" placeholder=\"Contoh: Pemeliharaan Sistem\">\n              </div>\n\n              <div class=\"field\">\n                <label>Tingkat Prioritas</label>\n                <div class=\"ui selection dropdown\">\n                  <input type=\"hidden\" name=\"prioritas\">\n                  <i class=\"dropdown icon\"></i>\n                  <div class=\"default text\">Pilih Tingkat Prioritas</div>\n                  <div class=\"menu\">\n                    <div class=\"item\" data-value=\"rendah\"><i class=\"blue circle icon\"></i> Informasi Biasa</div>\n                    <div class=\"item\" data-value=\"sedang\"><i class=\"yellow circle icon\"></i> Peringatan Sedang</div>\n                    <div class=\"item\" data-value=\"tinggi\"><i class=\"red circle icon\"></i> Kritis / Darurat</div>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"field\">\n                <label>Pesan Broadcast</label>\n                <textarea rows=\"3\" name=\"pesan\" placeholder=\"Tulis instruksi bagi seluruh operator...\"></textarea>\n              </div>\n\n              <!-- Pesan Error Validasi Otomatis -->\n              <div class=\"ui error message\"></div>\n\n              <button class=\"ui primary fluid button\" type=\"submit\">\n                <i class=\"paper plane icon\"></i>\n                Kirim Broadcast Sekarang\n              </button>\n            </form>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Modal Tambah Operator Baru -->\n  <div class=\"ui tiny modal\" id=\"modalOperator\">\n    <i class=\"close icon\"></i>\n    <div class=\"header\">\n      <i class=\"user plus icon\"></i>\n      Pendaftaran Operator Baru\n    </div>\n    <div class=\"content\">\n      <form class=\"ui form\" id=\"formModalOperator\">\n        <div class=\"field\">\n          <label>Nama Lengkap</label>\n          <input type=\"text\" placeholder=\"Masukkan nama operator\">\n        </div>\n        <div class=\"field\">\n          <label>Alamat Email Kantor</label>\n          <input type=\"email\" placeholder=\"nama@cloudmanager.id\">\n        </div>\n        <div class=\"field\">\n          <label>Hak Akses Level</label>\n          <div class=\"ui selection dropdown\">\n            <input type=\"hidden\" name=\"role\">\n            <i class=\"dropdown icon\"></i>\n            <div class=\"default text\">Pilih Hak Akses</div>\n            <div class=\"menu\">\n              <div class=\"item\" data-value=\"admin\">Super Administrator</div>\n              <div class=\"item\" data-value=\"devops\">DevOps Engineer</div>\n              <div class=\"item\" data-value=\"auditor\">Auditor (Read-Only)</div>\n            </div>\n          </div>\n        </div>\n      </form>\n    </div>\n    <div class=\"actions\">\n      <div class=\"ui cancel button\">Batal</div>\n      <div class=\"ui positive button\" id=\"btnSimpanOperator\">Simpan Operator</div>\n    </div>\n  </div>\n\n  <!-- jQuery & Fomantic-UI JS -->\n  <script src=\"https://code.jquery.com/jquery-3.7.1.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/fomantic-ui@2.9.3/dist/semantic.min.js\"></script>\n  <script>\n    $(document).ready(function() {\n      // 1. Toggle Sidebar Geser\n      $('#btnToggleSidebar').on('click', function() {\n        $('.ui.sidebar').sidebar('toggle');\n      });\n\n      // 2. Dropdown Inisialisasi\n      $('.ui.dropdown').dropdown();\n\n      // 3. Modal Handler\n      $('#btnBukaModal').on('click', function() {\n        $('#modalOperator').modal('show');\n      });\n\n      // 4. Modul Validasi Formulir Otomatis Semantic UI\n      $('#formDarurat').form({\n        fields: {\n          judul: {\n            identifier: 'judul',\n            rules: [\n              {\n                type: 'empty',\n                prompt: 'Silakan isi judul pemberitahuan terlebih dahulu.'\n              }\n            ]\n          },\n          prioritas: {\n            identifier: 'prioritas',\n            rules: [\n              {\n                type: 'empty',\n                prompt: 'Tingkat prioritas wajib dipilih.'\n              }\n            ]\n          },\n          pesan: {\n            identifier: 'pesan',\n            rules: [\n              {\n                type: 'minLength[10]',\n                prompt: 'Pesan broadcast minimal berisi 10 karakter.'\n              }\n            ]\n          }\n        },\n        onSuccess: function(event) {\n          event.preventDefault();\n          alert('Pemberitahuan darurat telah berhasil dikirim ke seluruh operator!');\n          $('#formDarurat').form('reset');\n        }\n      });\n    });\n  </script>\n</body>\n</html>\n","contentHash":"sha256:6012a993685eb4ca2ff649ace306103befbb6742d23f65b2079aeb7af7986d37"}]}