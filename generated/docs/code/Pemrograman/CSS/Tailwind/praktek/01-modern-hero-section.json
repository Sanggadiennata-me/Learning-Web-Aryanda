{"schemaVersion":1,"type":"code-folder","folder":"01-modern-hero-section","path":"Pemrograman/CSS/Tailwind/praktek/01-modern-hero-section","parentPath":"Pemrograman/CSS/Tailwind/praktek","outputPath":"code/Pemrograman/CSS/Tailwind/praktek/01-modern-hero-section","files":[{"name":"index.html","path":"Pemrograman/CSS/Tailwind/praktek/01-modern-hero-section/index.html","extension":".html","language":"html","size":4541,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 01: Modern SaaS Hero Section</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased selection:bg-blue-500 selection:text-white\">\n  <!-- Navbar -->\n  <header class=\"sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200\">\n    <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n      <div class=\"flex items-center gap-2\">\n        <div class=\"w-9 h-9 bg-gradient-to-tr from-blue-600 to-indigo-500 rounded-xl flex items-center justify-center text-white font-bold shadow-md shadow-blue-500/20\">\n          TW\n        </div>\n        <span class=\"font-bold text-lg text-slate-900 tracking-tight\">TailwindForge</span>\n      </div>\n      <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-slate-600\">\n        <a href=\"#\" class=\"hover:text-blue-600 transition\">Fitur</a>\n        <a href=\"#\" class=\"hover:text-blue-600 transition\">Komponen</a>\n        <a href=\"#\" class=\"hover:text-blue-600 transition\">Harga</a>\n        <a href=\"#\" class=\"hover:text-blue-600 transition\">Dokumentasi</a>\n      </nav>\n      <div class=\"flex items-center gap-3\">\n        <button class=\"text-sm font-semibold text-slate-600 hover:text-slate-900 px-3 py-2\">Masuk</button>\n        <button class=\"bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow-sm hover:shadow transition transform active:scale-95\">Daftar Gratis</button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Hero Content -->\n  <main class=\"relative overflow-hidden pt-12 pb-20\">\n    <!-- Glow Background Blur -->\n    <div class=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[300px] bg-gradient-to-tr from-blue-400 to-indigo-300 opacity-20 blur-3xl rounded-full pointer-events-none\"></div>\n\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10\">\n      <!-- Announcement Pill Badge -->\n      <div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6 shadow-sm\">\n        <span class=\"flex h-2 w-2 rounded-full bg-blue-600 animate-pulse\"></span>\n        <span>Versi 2.0 Kini Tersedia</span>\n        <span class=\"text-slate-400\">|</span>\n        <span class=\"hover:underline cursor-pointer\">Lihat Catatan Rilis &rarr;</span>\n      </div>\n\n      <!-- Main Headline with Gradient Text -->\n      <h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] mb-6\">\n        Bangun Antarmuka Modern <br>\n        <span class=\"bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent\">Lebih Cepat dengan Utility-First</span>\n      </h1>\n\n      <!-- Subtitle Paragraph -->\n      <p class=\"text-base sm:text-lg text-slate-600 max-w-2xl mx-auto mb-8 leading-relaxed\">\n        Tinggalkan penamaan class CSS yang membingungkan. Gunakan ribuan class atomik siap pakai untuk merancang layout responsif, interaksi mikro, dan tema gelap langsung di markup HTML Anda.\n      </p>\n\n      <!-- Action Buttons -->\n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-3 mb-14\">\n        <a href=\"#\" class=\"w-full sm:w-auto px-7 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-lg shadow-blue-500/25 transition transform hover:-translate-y-0.5 active:translate-y-0 text-sm\">\n          Mulai Belajar Sekarang\n        </a>\n        <a href=\"#\" class=\"w-full sm:w-auto px-7 py-3.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold rounded-xl shadow-sm transition text-sm\">\n          Lihat Komponen Contoh\n        </a>\n      </div>\n\n      <!-- Metrics Proof -->\n      <div class=\"grid grid-cols-3 gap-6 pt-8 border-t border-slate-200 max-w-xl mx-auto\">\n        <div>\n          <div class=\"text-2xl font-bold text-slate-900\">4.9 / 5</div>\n          <div class=\"text-xs text-slate-500 mt-1\">Rating Pengembang</div>\n        </div>\n        <div>\n          <div class=\"text-2xl font-bold text-slate-900\">50K+</div>\n          <div class=\"text-xs text-slate-500 mt-1\">Pengguna Aktif</div>\n        </div>\n        <div>\n          <div class=\"text-2xl font-bold text-slate-900\">99.9%</div>\n          <div class=\"text-xs text-slate-500 mt-1\">Uptime Sistem</div>\n        </div>\n      </div>\n    </div>\n  </main>\n</body>\n</html>\n","contentHash":"sha256:c5527104589ebc111e12a73e59a430fb11ad6f59135573717a13b8f0fcb62864"}]}