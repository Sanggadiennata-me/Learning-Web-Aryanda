{"schemaVersion":1,"type":"code-folder","folder":"02-dark-mode-dashboard","path":"Pemrograman/CSS/Tailwind/praktek/02-dark-mode-dashboard","parentPath":"Pemrograman/CSS/Tailwind/praktek","outputPath":"code/Pemrograman/CSS/Tailwind/praktek/02-dark-mode-dashboard","files":[{"name":"index.html","path":"Pemrograman/CSS/Tailwind/praktek/02-dark-mode-dashboard/index.html","extension":".html","language":"html","size":5293,"content":"<!DOCTYPE html>\n<html lang=\"id\" class=\"dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Praktek 02: Dark Mode & Dashboard Cards</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      darkMode: 'class'\n    }\n  </script>\n</head>\n<body class=\"bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 min-h-screen transition-colors duration-200 p-6 md:p-10\">\n  <div class=\"max-w-6xl mx-auto space-y-8\">\n    <!-- Top Bar with Dark Mode Switcher -->\n    <header class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-slate-900 dark:text-white\">Admin Dashboard</h1>\n        <p class=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">Implementasi varian dark mode Tailwind CSS dengan state class.</p>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <button id=\"toggleBtn\" onclick=\"document.documentElement.classList.toggle('dark')\" class=\"inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-sm font-semibold rounded-xl border border-slate-200 dark:border-slate-700 transition\">\n          <span class=\"dark:hidden\">☀️ Mode Terang Aktif</span>\n          <span class=\"hidden dark:inline\">🌙 Mode Gelap Aktif</span>\n        </button>\n        <button class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition\">\n          Buat Laporan\n        </button>\n      </div>\n    </header>\n\n    <!-- Stat Cards Grid (Flexbox & Grid Responsif) -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n      <!-- Card 1 -->\n      <div class=\"bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition\">\n        <div class=\"flex items-center justify-between text-slate-500 dark:text-slate-400 mb-3\">\n          <span class=\"text-xs font-semibold uppercase tracking-wider\">Total Pendapatan</span>\n          <span class=\"p-2 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 rounded-lg text-sm\">💰</span>\n        </div>\n        <div class=\"text-2xl font-extrabold text-slate-900 dark:text-white\">Rp 84.5M</div>\n        <div class=\"flex items-center gap-1.5 mt-2 text-xs font-medium text-emerald-600 dark:text-emerald-400\">\n          <span>↑ 18.2%</span>\n          <span class=\"text-slate-400 dark:text-slate-500\">dibanding bulan lalu</span>\n        </div>\n      </div>\n\n      <!-- Card 2 -->\n      <div class=\"bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition\">\n        <div class=\"flex items-center justify-between text-slate-500 dark:text-slate-400 mb-3\">\n          <span class=\"text-xs font-semibold uppercase tracking-wider\">Pengguna Baru</span>\n          <span class=\"p-2 bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400 rounded-lg text-sm\">👥</span>\n        </div>\n        <div class=\"text-2xl font-extrabold text-slate-900 dark:text-white\">+3,420</div>\n        <div class=\"flex items-center gap-1.5 mt-2 text-xs font-medium text-emerald-600 dark:text-emerald-400\">\n          <span>↑ 6.4%</span>\n          <span class=\"text-slate-400 dark:text-slate-500\">pertumbuhan mingguan</span>\n        </div>\n      </div>\n\n      <!-- Card 3 -->\n      <div class=\"bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition\">\n        <div class=\"flex items-center justify-between text-slate-500 dark:text-slate-400 mb-3\">\n          <span class=\"text-xs font-semibold uppercase tracking-wider\">Tingkat Konversi</span>\n          <span class=\"p-2 bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 rounded-lg text-sm\">📈</span>\n        </div>\n        <div class=\"text-2xl font-extrabold text-slate-900 dark:text-white\">4.85%</div>\n        <div class=\"flex items-center gap-1.5 mt-2 text-xs font-medium text-rose-600 dark:text-rose-400\">\n          <span>↓ 0.8%</span>\n          <span class=\"text-slate-400 dark:text-slate-500\">perlu optimasi funnel</span>\n        </div>\n      </div>\n\n      <!-- Card 4 -->\n      <div class=\"bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition\">\n        <div class=\"flex items-center justify-between text-slate-500 dark:text-slate-400 mb-3\">\n          <span class=\"text-xs font-semibold uppercase tracking-wider\">Beban Server</span>\n          <span class=\"p-2 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 rounded-lg text-sm\">⚡</span>\n        </div>\n        <div class=\"text-2xl font-extrabold text-slate-900 dark:text-white\">28%</div>\n        <div class=\"flex items-center gap-1.5 mt-2 text-xs font-medium text-emerald-600 dark:text-emerald-400\">\n          <span>Normal</span>\n          <span class=\"text-slate-400 dark:text-slate-500\">kapasitas sangat aman</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n","contentHash":"sha256:0dc459e373e0d6e1bdbf3e65e2104a4cc8da0f45f636fba095098155b5e99733"}]}